<%@ Master Language="VB"
    AutoEventWireup="false"
    CodeBehind="Site.master.vb"
    Inherits="WebApplication_keyove.Site" %>

<!DOCTYPE html>

<html>
<head runat="server">

    <meta charset="utf-8" />

    <title>KEYOVE</title>

    <asp:ContentPlaceHolder
        ID="head"
        runat="server">
    </asp:ContentPlaceHolder>

    <style>

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f6f9;
        }

        .contenedor {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 240px;
            background: #1f2937;
            color: white;
            padding: 20px 0;
        }

        .logo {
            text-align: center;
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 30px;
        }

        .sidebar a {
            display: block;
            padding: 12px 20px;
            color: white;
            text-decoration: none;
        }

        .sidebar a:hover {
            background: #374151;
        }

        .titulo-menu {
            padding: 15px 20px 5px;
            font-size: 12px;
            color: #9ca3af;
        }

        .contenido {
            flex: 1;
            padding: 25px;
        }

        .topbar {
            background: white;
            padding: 15px 25px;
            margin: -25px -25px 25px -25px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

    </style>

</head>

<body>

<form id="form1" runat="server">

    <div class="contenedor">

        <div class="sidebar">

            <div class="logo">
                KEYOVE
            </div>


            <a href="/Views/Dashboard/Dashboard.aspx">
                Dashboard
            </a>


            <div class="titulo-menu">
                MANTENIMIENTO
            </div>

            <a href="/Views/Mantenimiento/Categorias/Categorias.aspx">
                Categorías
            </a>

            <a href="/Views/Mantenimiento/Productos/Productos.aspx">
                Productos
            </a>

            <a href="/Views/Mantenimiento/Proveedores/Proveedores.aspx">
                Proveedores
            </a>

            <a href="/Views/Mantenimiento/Personas/Personas.aspx">
                Personas
            </a>

            <a href="/Views/Mantenimiento/Usuarios/Usuarios.aspx">
                Usuarios
            </a>

            <a href="/Views/Mantenimiento/Roles/Roles.aspx">
                Roles
            </a>


            <div class="titulo-menu">
                OPERACIONES
            </div>

            <a href="/Views/Operaciones/Compras/Compras.aspx">
                Compras
            </a>

            <a href="/Views/Operaciones/Ventas/Ventas.aspx">
                Ventas
            </a>


            <div class="titulo-menu">
                INVENTARIO
            </div>

            <a href="/Views/Inventario/Movimientos_Inventario/Movimientos_Inventario.aspx">
                Movimientos
            </a>

        </div>


        <div class="contenido">

            <div class="topbar">

                <strong>Sistema de Inventario KEYOVE</strong>

            </div>


            <asp:ContentPlaceHolder
                ID="ContentPlaceHolder1"
                runat="server">

            </asp:ContentPlaceHolder>

        </div>

    </div>

</form>

</body>
</html>