<%@ Master Language="VB"
    AutoEventWireup="false"
    CodeBehind="Site.master.vb"
    Inherits="WebApplication_keyove.Site" %>

<!DOCTYPE html>

<html>
<head runat="server">

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>KEYOVE</title>

    <link rel="stylesheet" href="/Assets/css/site.css" />

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <asp:ContentPlaceHolder
        ID="head"
        runat="server">
    </asp:ContentPlaceHolder>

</head>

<body>

<form id="form1" runat="server">

    <div class="contenedor">

        <aside class="sidebar" id="sidebar">

            <div class="logo">

                <span class="logo-icono">K</span>

                <span>KEYOVE</span>

            </div>

            <button type="button" class="btn-ocultar-panel" id="btnOcultarPanel">Ocultar panel de control</button>

            <nav class="menu" aria-label="Panel de control">

                <a class="menu-link"
                   data-ruta="/Views/Dashboard/Dashboard.aspx"
                   href="/Views/Dashboard/Dashboard.aspx">
                    Dashboard
                </a>

                <div class="titulo-menu">
                    MANTENIMIENTO
                </div>

                <a class="menu-link"
                   data-ruta="/Views/Mantenimiento/Categorias/Categorias.aspx"
                   href="/Views/Mantenimiento/Categorias/Categorias.aspx">
                    Categorías
                </a>

                <a class="menu-link"
                   data-ruta="/Views/Mantenimiento/Productos/Productos.aspx"
                   href="/Views/Mantenimiento/Productos/Productos.aspx">
                    Productos
                </a>

                <a class="menu-link"
                   data-ruta="/Views/Mantenimiento/Proveedores/Proveedores.aspx"
                   href="/Views/Mantenimiento/Proveedores/Proveedores.aspx">
                    Proveedores
                </a>

                <a class="menu-link"
                   data-ruta="/Views/Mantenimiento/Personas/Personas.aspx"
                   href="/Views/Mantenimiento/Personas/Personas.aspx">
                    Personas
                </a>

                <a class="menu-link"
                   data-ruta="/Views/Mantenimiento/Usuarios/Usuarios.aspx"
                   href="/Views/Mantenimiento/Usuarios/Usuarios.aspx">
                    Usuarios
                </a>

                <a class="menu-link"
                   data-ruta="/Views/Mantenimiento/Roles/Roles.aspx"
                   href="/Views/Mantenimiento/Roles/Roles.aspx">
                    Roles
                </a>

                <div class="titulo-menu">
                    OPERACIONES
                </div>

                <details class="menu-grupo" id="menuCompras">
                    <summary class="menu-link">Compras</summary>
                    <div class="submenu">
                        <a class="menu-link" data-vista-compras="registro" data-ruta="/Views/Operaciones/Compras/Compras.aspx"
                           href="/Views/Operaciones/Compras/Compras.aspx">Nueva compra</a>
                        <a class="menu-link" data-vista-compras="registros" data-ruta="/Views/Operaciones/Compras/Compras.aspx?vista=registros"
                           href="/Views/Operaciones/Compras/Compras.aspx?vista=registros">Compras realizadas</a>
                    </div>
                </details>

                <details class="menu-grupo" id="menuVentas">
                    <summary class="menu-link">Ventas</summary>
                    <div class="submenu">
                        <a class="menu-link" data-vista-ventas="registro" data-ruta="/Views/Operaciones/Ventas/Ventas.aspx"
                           href="/Views/Operaciones/Ventas/Ventas.aspx">Nueva venta</a>
                        <a class="menu-link" data-vista-ventas="registros" data-ruta="/Views/Operaciones/Ventas/Ventas.aspx?vista=registros"
                           href="/Views/Operaciones/Ventas/Ventas.aspx?vista=registros">Ventas registradas</a>
                    </div>
                </details>

                <div class="titulo-menu">
                    INVENTARIO
                </div>

                <a class="menu-link"
                   data-ruta="/Views/Inventario/Movimientos_Inventario/Movimientos_Inventario.aspx"
                   href="/Views/Inventario/Movimientos_Inventario/Movimientos_Inventario.aspx">
                    Movimientos
                </a>

                <div class="menu-separador"></div>

                <a class="menu-link cerrar-sesion"
                   href="#">
                    Cerrar sesión
                </a>

            </nav>

        </aside>

        <button type="button" id="fondoMenu" class="fondo-menu" aria-label="Cerrar menú" hidden></button>

        <main class="contenido">

            <header class="topbar">

                <button type="button"
                        class="btn-menu-toggle"
                        id="btnMenuToggle"
                        aria-label="Ocultar panel de control" aria-controls="sidebar" aria-expanded="true">
                    <span aria-hidden="true">&#9776;</span>
                    <span id="textoPanelControl">Ocultar panel</span>
                </button>

                <div class="topbar-titulo">
                    Sistema de Inventario KEYOVE
                </div>

            </header>

            <div class="contenido-inner">

                <asp:ContentPlaceHolder
                    ID="ContentPlaceHolder1"
                    runat="server">

                </asp:ContentPlaceHolder>

            </div>

        </main>

    </div>

</form>

<script>

    $(function () {

        // Resalta el enlace de la página actual en el menú.
        var rutaActual = window.location.pathname;
        if (new URLSearchParams(window.location.search).get("vista") === "registros") rutaActual += "?vista=registros";

        $(".menu-link").each(function () {

            var ruta = $(this).attr("data-ruta");

            if (ruta && rutaActual.toLowerCase() === ruta.toLowerCase()) {

                $(this).addClass("active");
                $(this).attr("aria-current", "page");
                $(this).closest("details").prop("open", true);

            }

        });

        var pantallaMovil = window.matchMedia("(max-width: 768px)");
        var contraido = false;
        var movilAbierto = false;
        try { contraido = localStorage.getItem("keyoveMenuContraido") === "true"; } catch (e) {}

        function actualizarMenu() {
            var visible = pantallaMovil.matches ? movilAbierto : !contraido;
            $(".contenedor").toggleClass("menu-contraido", !pantallaMovil.matches && contraido);
            $("#sidebar").toggleClass("abierto", pantallaMovil.matches && movilAbierto);
            document.getElementById("sidebar").inert = !visible;
            $("#sidebar").attr("aria-hidden", String(!visible));
            $("#btnMenuToggle").attr("aria-expanded", String(visible))
                .attr("aria-label", visible ? "Ocultar panel de control" : "Mostrar panel de control");
            $("#textoPanelControl").text(visible ? "Ocultar panel" : "Mostrar panel");
            $("#fondoMenu").prop("hidden", !(pantallaMovil.matches && movilAbierto));
        }

        $("#btnMenuToggle").on("click", function () {
            if (pantallaMovil.matches) movilAbierto = !movilAbierto;
            else {
                contraido = !contraido;
                try { localStorage.setItem("keyoveMenuContraido", String(contraido)); } catch (e) {}
            }
            actualizarMenu();
        });
        $("#fondoMenu").on("click", function () {
            movilAbierto = false;
            actualizarMenu();
            $("#btnMenuToggle").trigger("focus");
        });
        $("#btnOcultarPanel").on("click", function () {
            if (pantallaMovil.matches) movilAbierto = false;
            else {
                contraido = true;
                try { localStorage.setItem("keyoveMenuContraido", "true"); } catch (e) {}
            }
            actualizarMenu();
            $("#btnMenuToggle").trigger("focus");
        });
        $(document).on("keydown", function (evento) {
            if (evento.key === "Escape" && pantallaMovil.matches && movilAbierto) {
                $("#fondoMenu").trigger("click");
            }
        });
        pantallaMovil.addEventListener("change", function () {
            movilAbierto = false;
            actualizarMenu();
        });
        actualizarMenu();

    });

</script>

</body>
</html>
