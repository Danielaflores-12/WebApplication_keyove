<%@ Master Language="VB"
    AutoEventWireup="false"
    CodeBehind="Site.master.vb"
    Inherits="WebApplication_keyove.Site" %>

<!DOCTYPE html>

<html>
<head runat="server">

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>KEYOVE</title>

    <link rel="stylesheet" href="/Assets/css/site.css" />

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <asp:ContentPlaceHolder
        ID="head"
        runat="server">
    </asp:ContentPlaceHolder>

</head>

<body>

<form id="form1" runat="server">

    <div class="contenedor">

        <aside class="sidebar" id="sidebar">

            <div class="logo">

                <span class="logo-icono">K</span>

                <span>KEYOVE</span>

            </div>

            <nav class="menu">

                <a class="menu-link"
                   data-ruta="/Views/Dashboard/Dashboard.aspx"
                   href="/Views/Dashboard/Dashboard.aspx">
                    Dashboard
                </a>

                <div class="titulo-menu">
                    MANTENIMIENTO
                </div>

                <a class="menu-link"
                   data-ruta="/Views/Mantenimiento/Categorias/Categorias.aspx"
                   href="/Views/Mantenimiento/Categorias/Categorias.aspx">
                    Categorías
                </a>

                <a class="menu-link"
                   data-ruta="/Views/Mantenimiento/Productos/Productos.aspx"
                   href="/Views/Mantenimiento/Productos/Productos.aspx">
                    Productos
                </a>

                <a class="menu-link"
                   data-ruta="/Views/Mantenimiento/Proveedores/Proveedores.aspx"
                   href="/Views/Mantenimiento/Proveedores/Proveedores.aspx">
                    Proveedores
                </a>

                <a class="menu-link"
                   data-ruta="/Views/Mantenimiento/Personas/Personas.aspx"
                   href="/Views/Mantenimiento/Personas/Personas.aspx">
                    Personas
                </a>

                <a class="menu-link"
                   data-ruta="/Views/Mantenimiento/Usuarios/Usuarios.aspx"
                   href="/Views/Mantenimiento/Usuarios/Usuarios.aspx">
                    Usuarios
                </a>

                <a class="menu-link"
                   data-ruta="/Views/Mantenimiento/Roles/Roles.aspx"
                   href="/Views/Mantenimiento/Roles/Roles.aspx">
                    Roles
                </a>

                <div class="titulo-menu">
                    OPERACIONES
                </div>

                <a class="menu-link"
                   data-ruta="/Views/Operaciones/Compras/Compras.aspx"
                   href="/Views/Operaciones/Compras/Compras.aspx">
                    Compras
                </a>

                <a class="menu-link"
                   data-ruta="/Views/Operaciones/Ventas/Ventas.aspx"
                   href="/Views/Operaciones/Ventas/Ventas.aspx">
                    Ventas
                </a>

                <div class="titulo-menu">
                    INVENTARIO
                </div>

                <a class="menu-link"
                   data-ruta="/Views/Inventario/Movimientos_Inventario/Movimientos_Inventario.aspx"
                   href="/Views/Inventario/Movimientos_Inventario/Movimientos_Inventario.aspx">
                    Movimientos
                </a>

                <div class="menu-separador"></div>

                <a class="menu-link cerrar-sesion"
                   href="#">
                    Cerrar sesión
                </a>

            </nav>

        </aside>

        <main class="contenido">

            <header class="topbar">

                <button type="button"
                        class="btn-menu-toggle"
                        id="btnMenuToggle"
                        aria-label="Abrir menú">
                    &#9776;
                </button>

                <div class="topbar-titulo">
                    Sistema de Inventario KEYOVE
                </div>

            </header>

            <div class="contenido-inner">

                <asp:ContentPlaceHolder
                    ID="ContentPlaceHolder1"
                    runat="server">

                </asp:ContentPlaceHolder>

            </div>

        </main>

    </div>

</form>

<script>

    $(function () {

        // Resalta el enlace de la página actual en el menú.
        var rutaActual = window.location.pathname;

        $(".menu-link").each(function () {

            var ruta = $(this).attr("data-ruta");

            if (ruta && rutaActual.indexOf(ruta) !== -1) {

                $(this).addClass("active");

            }

        });

        // Abre/cierra el menú lateral en pantallas pequeñas.
        $("#btnMenuToggle").on("click", function () {

            $("#sidebar").toggleClass("abierto");

        });

    });

</script>

</body>
</html>