<%@ Master Language="VB"
    AutoEventWireup="false"
    CodeBehind="Site.master.vb"
    Inherits="WebApplication_keyove.Site" %>

<!DOCTYPE html>
<html lang="es">

<head runat="server">

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>KEYOVE</title>

    <link rel="stylesheet"
          href="<%= ResolveUrl("~/Assets/css/site.css") %>" />

    <style>

        .topbar {
            display: flex;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
        }


        .perfil-usuario {
            margin-left: auto;
            display: flex;
            align-items: center;
            gap: 12px;
        }


        .perfil-avatar {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: #ede9fe;
            color: #6d28d9;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            font-weight: bold;
            flex-shrink: 0;
        }


        .perfil-datos {
            display: flex;
            flex-direction: column;
            gap: 3px;
        }


        .perfil-nombre {
            color: #172033;
            font-weight: 600;
        }


        .perfil-rol {
            color: #64748b;
            font-size: 12px;
        }


        .perfil-salir {
            padding: 8px 12px;
            border: 1px solid #fecaca;
            border-radius: 8px;
            color: #b91c1c;
            text-decoration: none;
            font-size: 13px;
        }


        .perfil-salir:hover {
            background: #fef2f2;
        }


        @media (max-width: 768px) {

            .perfil-usuario {
                width: 100%;
                justify-content: flex-end;
            }

        }


        /* ========================================= */
        /* ALERTAS DE STOCK                          */
        /* ========================================= */

        .alerta-stock-menu {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }


        .badge-alertas-stock {
            min-width: 22px;
            height: 22px;
            padding: 0 6px;
            border-radius: 999px;
            background: #dc2626;
            color: #ffffff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            font-weight: 700;
            line-height: 1;
            box-sizing: border-box;
        }


        .badge-alertas-stock.sin-alertas {
            display: none;
        }

    </style>

    <asp:ContentPlaceHolder
        ID="head"
        runat="server" />

</head>


<body data-rol="<%= System.Web.HttpUtility.HtmlAttributeEncode(Convert.ToString(Session("Rol"))) %>">

<form id="form1" runat="server">

    <div class="contenedor">


        <!-- ========================= -->
        <!-- BARRA LATERAL -->
        <!-- ========================= -->

        <aside class="sidebar" id="sidebar">


            <div class="logo">

                <span class="logo-icono">K</span>

                <span>KEYOVE</span>

            </div>


            <nav class="menu" aria-label="Panel de control">


                <!-- ========================= -->
                <!-- DASHBOARD -->
                <!-- ========================= -->

                <asp:PlaceHolder
                    ID="menuDashboard"
                    runat="server">

                    <a class="menu-link"
                       data-ruta="<%= ResolveUrl("~/Views/Dashboard/Dashboard.aspx") %>"
                       href="<%= ResolveUrl("~/Views/Dashboard/Dashboard.aspx") %>">

                        Dashboard

                    </a>

                </asp:PlaceHolder>



                <!-- ========================= -->
                <!-- MANTENIMIENTO -->
                <!-- ========================= -->

                <asp:PlaceHolder
                    ID="menuMantenimiento"
                    runat="server">

                    <div class="titulo-menu">
                        MANTENIMIENTO
                    </div>


                    <a class="menu-link"
                       data-ruta="<%= ResolveUrl("~/Views/Mantenimiento/Categorias/Categorias.aspx") %>"
                       href="<%= ResolveUrl("~/Views/Mantenimiento/Categorias/Categorias.aspx") %>">

                        Categorías

                    </a>


                    <a class="menu-link"
                       data-ruta="<%= ResolveUrl("~/Views/Mantenimiento/Productos/Productos.aspx") %>"
                       href="<%= ResolveUrl("~/Views/Mantenimiento/Productos/Productos.aspx") %>">

                        Productos

                    </a>


                    <a class="menu-link"
                       data-ruta="<%= ResolveUrl("~/Views/Mantenimiento/Proveedores/Proveedores.aspx") %>"
                       href="<%= ResolveUrl("~/Views/Mantenimiento/Proveedores/Proveedores.aspx") %>">

                        Proveedores

                    </a>


                    <a class="menu-link"
                       data-ruta="<%= ResolveUrl("~/Views/Mantenimiento/Personas/Personas.aspx") %>"
                       href="<%= ResolveUrl("~/Views/Mantenimiento/Personas/Personas.aspx") %>">

                        Personas

                    </a>


                    <a class="menu-link"
                       data-ruta="<%= ResolveUrl("~/Views/Mantenimiento/Usuarios/Usuarios.aspx") %>"
                       href="<%= ResolveUrl("~/Views/Mantenimiento/Usuarios/Usuarios.aspx") %>">

                        Usuarios

                    </a>


                    <a class="menu-link"
                       data-ruta="<%= ResolveUrl("~/Views/Mantenimiento/Roles/Roles.aspx") %>"
                       href="<%= ResolveUrl("~/Views/Mantenimiento/Roles/Roles.aspx") %>">

                        Roles

                    </a>

                </asp:PlaceHolder>



                <!-- ========================= -->
                <!-- OPERACIONES -->
                <!-- ========================= -->

                <div class="titulo-menu">
                    OPERACIONES
                </div>



                <!-- ========================= -->
                <!-- COMPRAS -->
                <!-- ========================= -->

                <asp:PlaceHolder
                    ID="menuComprasAdmin"
                    runat="server">

                    <details
                        class="menu-grupo"
                        id="menuCompras">

                        <summary class="menu-link">
                            Compras
                        </summary>


                        <div class="submenu">


                            <a class="menu-link"
                               data-vista-compras="registro"
                               data-ruta="<%= ResolveUrl("~/Views/Operaciones/Compras/Compras.aspx") %>"
                               href="<%= ResolveUrl("~/Views/Operaciones/Compras/Compras.aspx") %>">

                                Nueva compra

                            </a>


                            <a class="menu-link"
                               data-vista-compras="registros"
                               data-ruta="<%= ResolveUrl("~/Views/Operaciones/Compras/Compras.aspx?vista=registros") %>"
                               href="<%= ResolveUrl("~/Views/Operaciones/Compras/Compras.aspx?vista=registros") %>">

                                Compras realizadas

                            </a>


                        </div>

                    </details>

                </asp:PlaceHolder>



                <!-- ========================= -->
                <!-- VENTAS -->
                <!-- ========================= -->

                <asp:PlaceHolder
                    ID="menuVentasPermitido"
                    runat="server">

                    <details
                        class="menu-grupo"
                        id="menuVentas">

                        <summary class="menu-link">

                            Ventas

                        </summary>


                        <div class="submenu">


                            <a class="menu-link"
                               data-vista-ventas="registro"
                               data-ruta="<%= ResolveUrl("~/Views/Operaciones/Ventas/Ventas.aspx") %>"
                               href="<%= ResolveUrl("~/Views/Operaciones/Ventas/Ventas.aspx") %>">

                                Nueva venta

                            </a>


                            <a class="menu-link"
                               data-vista-ventas="registros"
                               data-ruta="<%= ResolveUrl("~/Views/Operaciones/Ventas/Ventas.aspx?vista=registros") %>"
                               href="<%= ResolveUrl("~/Views/Operaciones/Ventas/Ventas.aspx?vista=registros") %>">

                                Ventas registradas

                            </a>


                        </div>

                    </details>

                </asp:PlaceHolder>



                <!-- ========================= -->
                <!-- INVENTARIO -->
                <!-- ========================= -->

                <asp:PlaceHolder
                    ID="menuInventario"
                    runat="server">

                    <div class="titulo-menu">
                        INVENTARIO
                    </div>


                    <a class="menu-link"
                       data-ruta="<%= ResolveUrl("~/Views/Inventario/Movimientos_Inventario/Movimientos_Inventario.aspx") %>"
                       href="<%= ResolveUrl("~/Views/Inventario/Movimientos_Inventario/Movimientos_Inventario.aspx") %>">

                        Movimientos

                    </a>


                    <!-- ========================= -->
                    <!-- ALERTAS DE STOCK -->
                    <!-- ========================= -->

                    <a class="menu-link alerta-stock-menu"
                       data-ruta="<%= ResolveUrl("~/Views/Inventario/Alertas_Stock/Alertas_Stock.aspx") %>"
                       href="<%= ResolveUrl("~/Views/Inventario/Alertas_Stock/Alertas_Stock.aspx") %>">

                        <span>
                            Alertas de Stock
                        </span>


                        <span id="badgeAlertasStock"
                              class="badge-alertas-stock <%= If(Convert.ToInt32(If(Session("CantidadAlertasStock"), 0)) = 0, "sin-alertas", "") %>"
                              aria-label="Cantidad de alertas de stock">

                            <%= Convert.ToInt32(If(Session("CantidadAlertasStock"), 0)) %>

                        </span>

                    </a>

                </asp:PlaceHolder>


            </nav>

        </aside>



        <!-- ========================= -->
        <!-- FONDO MENU MOVIL -->
        <!-- ========================= -->

        <button type="button"
                id="fondoMenu"
                class="fondo-menu"
                aria-label="Cerrar menú"
                hidden>
        </button>



        <!-- ========================= -->
        <!-- CONTENIDO PRINCIPAL -->
        <!-- ========================= -->

        <main class="contenido">


            <!-- ========================= -->
            <!-- BARRA SUPERIOR -->
            <!-- ========================= -->

            <header class="topbar">


                <button type="button"
                        class="btn-menu-toggle"
                        id="btnMenuToggle"
                        aria-label="Ocultar panel de control"
                        aria-controls="sidebar"
                        aria-expanded="true">

                    <span aria-hidden="true">
                        &#9776;
                    </span>


                    <span id="textoPanelControl">
                        Ocultar panel
                    </span>

                </button>



                <div class="topbar-titulo">

                    Sistema de Inventario KEYOVE

                </div>



                <!-- PERFIL -->

                <div class="perfil-usuario">


                    <div class="perfil-avatar"
                         aria-hidden="true">

                        <asp:Literal
                            ID="litInicial"
                            runat="server"
                            Mode="Encode" />

                    </div>


                    <div class="perfil-datos">


                        <span class="perfil-nombre">

                            <asp:Literal
                                ID="litNombre"
                                runat="server"
                                Mode="Encode" />

                        </span>


                        <span class="perfil-rol">

                            <asp:Literal
                                ID="litRol"
                                runat="server"
                                Mode="Encode" />

                        </span>


                    </div>



                    <asp:LinkButton
                        ID="btnCerrarSesionPerfil"
                        runat="server"
                        CssClass="perfil-salir"
                        CausesValidation="false"
                        OnClick="CerrarSesion_Click">

                        Cerrar sesión

                    </asp:LinkButton>


                </div>


            </header>



            <!-- ========================= -->
            <!-- CONTENIDO DE CADA PAGINA -->
            <!-- ========================= -->

            <div class="contenido-inner">


                <asp:ContentPlaceHolder
                    ID="ContentPlaceHolder1"
                    runat="server" />


            </div>


        </main>


    </div>


</form>



<!-- ===================================================== -->
<!-- JAVASCRIPT DEL MENU                                   -->
<!-- ===================================================== -->

<script>

    document.addEventListener(
        "DOMContentLoaded",
        function () {


            /* ========================================= */
            /* PAGINA ACTUAL                              */
            /* ========================================= */

            var rutaActual =
                window.location.pathname;


            var parametros =
                new URLSearchParams(
                    window.location.search
                );


            if (
                parametros.get("vista") ===
                "registros"
            ) {

                rutaActual +=
                    "?vista=registros";

            }



            /* ========================================= */
            /* MARCAR MENU ACTIVO                         */
            /* ========================================= */

            var enlaces =
                document.querySelectorAll(
                    ".menu-link"
                );


            enlaces.forEach(
                function (enlace) {


                    var ruta =
                        enlace.getAttribute(
                            "data-ruta"
                        );


                    if (
                        ruta &&
                        rutaActual.toLowerCase() ===
                        ruta.toLowerCase()
                    ) {


                        enlace.classList.add(
                            "active"
                        );


                        enlace.setAttribute(
                            "aria-current",
                            "page"
                        );


                        var details =
                            enlace.closest(
                                "details"
                            );


                        if (details) {

                            details.open = true;

                        }

                    }

                }
            );



            /* ========================================= */
            /* VARIABLES DEL MENU                         */
            /* ========================================= */

            var pantallaMovil =
                window.matchMedia(
                    "(max-width: 768px)"
                );


            var contraido = false;

            var movilAbierto = false;



            /* ========================================= */
            /* MEMORIA DEL MENU                           */
            /* ========================================= */

            try {

                contraido =
                    localStorage.getItem(
                        "keyoveMenuContraido"
                    ) === "true";

            }
            catch (e) {

            }



            /* ========================================= */
            /* ACTUALIZAR MENU                            */
            /* ========================================= */

            function actualizarMenu() {


                var visible =
                    pantallaMovil.matches
                        ? movilAbierto
                        : !contraido;


                var contenedor =
                    document.querySelector(
                        ".contenedor"
                    );


                var sidebar =
                    document.getElementById(
                        "sidebar"
                    );


                var botonMenu =
                    document.getElementById(
                        "btnMenuToggle"
                    );


                var textoPanel =
                    document.getElementById(
                        "textoPanelControl"
                    );


                var fondoMenu =
                    document.getElementById(
                        "fondoMenu"
                    );



                /* CONTENEDOR */

                if (contenedor) {

                    contenedor.classList.toggle(
                        "menu-contraido",
                        !pantallaMovil.matches &&
                        contraido
                    );

                }



                /* SIDEBAR */

                if (sidebar) {

                    sidebar.classList.toggle(
                        "abierto",
                        pantallaMovil.matches &&
                        movilAbierto
                    );


                    sidebar.setAttribute(
                        "aria-hidden",
                        String(!visible)
                    );


                    sidebar.inert =
                        !visible;

                }



                /* BOTON */

                if (botonMenu) {

                    botonMenu.setAttribute(
                        "aria-expanded",
                        String(visible)
                    );


                    botonMenu.setAttribute(
                        "aria-label",
                        visible
                            ? "Ocultar panel de control"
                            : "Mostrar panel de control"
                    );

                }



                /* TEXTO BOTON */

                if (textoPanel) {

                    textoPanel.textContent =
                        visible
                            ? "Ocultar panel"
                            : "Mostrar panel";

                }



                /* FONDO MOVIL */

                if (fondoMenu) {

                    fondoMenu.hidden =
                        !(
                            pantallaMovil.matches &&
                            movilAbierto
                        );

                }

            }



            /* ========================================= */
            /* BOTON MENU                                 */
            /* ========================================= */

            var botonMenu =
                document.getElementById(
                    "btnMenuToggle"
                );


            if (botonMenu) {

                botonMenu.addEventListener(
                    "click",
                    function () {


                        if (
                            pantallaMovil.matches
                        ) {

                            movilAbierto =
                                !movilAbierto;

                        }
                        else {

                            contraido =
                                !contraido;


                            try {

                                localStorage.setItem(
                                    "keyoveMenuContraido",
                                    String(
                                        contraido
                                    )
                                );

                            }
                            catch (e) {

                            }

                        }


                        actualizarMenu();

                    }
                );

            }



            /* ========================================= */
            /* CERRAR MENU MOVIL                          */
            /* ========================================= */

            var fondoMenu =
                document.getElementById(
                    "fondoMenu"
                );


            if (fondoMenu) {

                fondoMenu.addEventListener(
                    "click",
                    function () {


                        movilAbierto =
                            false;


                        actualizarMenu();


                        if (botonMenu) {

                            botonMenu.focus();

                        }

                    }
                );

            }



            /* ========================================= */
            /* TECLA ESCAPE                               */
            /* ========================================= */

            document.addEventListener(
                "keydown",
                function (evento) {


                    if (
                        evento.key === "Escape" &&
                        pantallaMovil.matches &&
                        movilAbierto
                    ) {


                        if (fondoMenu) {

                            fondoMenu.click();

                        }

                    }

                }
            );



            /* ========================================= */
            /* CAMBIO DE TAMAÑO DE PANTALLA               */
            /* ========================================= */

            pantallaMovil.addEventListener(
                "change",
                function () {


                    movilAbierto =
                        false;


                    actualizarMenu();

                }
            );



            /* ========================================= */
            /* INICIALIZAR MENU                           */
            /* ========================================= */

            actualizarMenu();


        }
    );

</script>


</body>

</html>